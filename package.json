{
  "name": "booking-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Booking Platform v0 - Dual-Engine HTTP Service (Native Node.js vs NestJS)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:native": "tsx src/native/main.ts",
    "start:nestjs": "tsx src/nestjs/main.ts",
    "test": "tsx --test tests/contract/*.test.ts tests/unit/*.test.ts",
    "test:native": "tsx --test tests/contract/native-server.test.ts",
    "test:nestjs": "tsx --test tests/contract/nestjs-server.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
